# CLI-only fallback. The web UI accepts a key per request; keep this empty on Render.
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_MODEL=gpt-5-mini
USE_LLM=false

# Render's free filesystem is temporary; SQLite is only for short-lived history.
STOCK_AGENT_DB=data/agent.db
STOCK_DATA_PROVIDER=yfinance
NEWS_LIMIT=8
